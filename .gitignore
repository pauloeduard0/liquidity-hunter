# Replay cache: derived from a fetched series, regenerated on demand.
research/.replay_cache/

# Klines cache: raw candles re-fetchable from the exchange at any time.
research/.klines_cache/

# Claude Code: local machine settings (the skills/ dir stays versioned).
.claude/settings.local.json

# Study exports: the dated trade sets are large (tens of MB) and fully
# reproducible from the command recorded in docs/block_reclaim.md.
trades*.json
manage.json

# paper journal (local run output)
paper_journal.jsonl

# Datasets de pesquisa (grandes, reproduziveis por research/quality_features.py)
research/.datasets/
research/.klines_cache/
research/.equity_cache/

# Cache SQLite de candles (regenerado sob demanda pelo CachingOHLCVProvider).
candles.sqlite3

# Export de dataset do deep_reclaim: reproduzivel por research/deep_reclaim.py.
deep_btc_eth.json

# Snapshots reais de /api/dashboard para o harness do PISO (P1).
# Reproduziveis por frontend/research/captureFixtures.sh; grandes (~1,1MB cada).
frontend/research/fixtures/
frontend/research/piso_audit_baseline.json
frontend/research/piso_families_baseline.json
frontend/research/piso_structural_baseline.json
